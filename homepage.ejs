<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Dashboard - Catering Service</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/dashboard">Catering Service</a>
            <div class="d-flex align-items-center gap-3">
                <span class="text-white">Welcome, <%= user.user_name %></span>
                <a href="/view" class="btn btn-sm btn-outline-light">My Bookings</a>
                <a href="/change-password" class="btn btn-sm btn-outline-light">Account</a>
                <a href="/logout" class="btn btn-sm btn-danger">Logout</a>
            </div>
        </div>
    </nav>

    <div class="container py-4">
        <!-- Booking Form Section -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Book a Catering Event</h4>
            </div>
            <div class="card-body">
                <form action="/book" method="POST">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Customer Name</label>
                            <input type="text" name="customer_name" value="<%= user.user_name %>" class="form-control" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Event Date</label>
                            <input type="date" name="event_date" class="form-control" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Package Type</label>
                            <select name="package_type" class="form-select" required>
                                <option value="Standard">Standard (₱300 / head)</option>
                                <option value="Deluxe">Deluxe (₱500 / head)</option>
                                <option value="Premium">Premium (₱800 / head)</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Guest Count</label>
                            <input type="number" name="guest_count" min="10" class="form-control" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Event Address</label>
                            <input type="text" name="address" class="form-control" required>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-success mt-3">Book & Select Food Menu</button>
                </form>
            </div>
        </div>

        <!-- Recent Bookings Table -->
        <div class="card shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Your Recent Bookings</h5>
                <a href="/view" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="card-body p-0">
                <% if (recentBookings.length === 0) { %>
                    <p class="p-3 text-muted mb-0">No bookings yet. Fill out the form above to place your first order!</p>
                <% } else { %>
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Event Date</th>
                                <th>Package</th>
                                <th>Guests</th>
                                <th>Total Price</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% recentBookings.forEach(b => { %>
                                <tr>
                                    <td><%= b.id %></td>
                                    <td><%= b.event_date %></td>
                                    <td><%= b.package_type %></td>
                                    <td><%= b.guest_count %></td>
                                    <td>₱<%= b.total_price %></td>
                                    <td><span class="badge bg-info"><%= b.payment_status %></span></td>
                                    <td>
                                        <a href="/select-food/<%= b.id %>" class="btn btn-sm btn-outline-secondary">Food Menu</a>
                                        <a href="/delete/<%= b.id %>" onclick="return confirm('Cancel this reservation?')" class="btn btn-sm btn-outline-danger">Cancel</a>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                <% } %>
            </div>
        </div>
    </div>

</body>
</html>